class Solution {
    public int numberOfSteps(int num) {
        if(num==0){
            return 0;
        }
        int below=0;
        if(num%2==0){
            below=numberOfSteps(num/2);
        }else{
            below=numberOfSteps(num-1);
        }
        int result=below+1;
        return result;
    }
}
